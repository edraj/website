{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "paths": { "$lib/*": ["./src/lib/*"], "$content/*": ["./src/content/*"] }
  },
  "include": ["src/**/*.svelte", "src/**/*.js", "src/**/*.ts", "src/**/*.d.ts"]
}
